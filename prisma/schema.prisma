// ==========================================================
// HAIRGRAB CORE
// HairGrab-owned marketplace operating system
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ==========================================================
// SHOPIFY SESSION
// ==========================================================

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


// ==========================================================
// SELLER APPLICATION
// ==========================================================

model SellerApplication {
  id                  String   @id @default(cuid())

  // PENDING / APPROVED / DECLINED / WITHDRAWN
  status              String   @default("PENDING")

  businessName        String
  contactFirstName    String
  contactLastName     String
  email               String
  phone               String?

  website             String?
  instagram           String?
  tiktok              String?

  address1            String?
  address2            String?
  city                String?
  state               String?
  postalCode          String?
  country             String   @default("US")

  yearsInBusiness     String?
  productCountRange   String?
  canImportCsv        Boolean?

  sellsNationwide     Boolean  @default(true)
  offersLocalPickup   Boolean  @default(false)
  offersLocalDelivery Boolean  @default(false)

  notes               String?
  adminReviewNotes    String?

  submittedAt         DateTime @default(now())
  reviewedAt          DateTime?
  approvedAt          DateTime?
  declinedAt          DateTime?

  approvedSellerId    String?  @unique
  approvedSeller      Seller?  @relation("ApprovedSellerApplication", fields: [approvedSellerId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([businessName])
}


// ==========================================================
// SELLER
// Permanent HairGrab marketplace identity.
// HG-0001 stays HG-0001 even if the business name changes.
// ==========================================================

model Seller {
  id                  String   @id @default(cuid())

  sellerCode          String   @unique

  businessName        String
  legalBusinessName   String?

  contactFirstName    String?
  contactLastName     String?
  email               String?
  phone               String?

  website             String?
  instagram           String?
  tiktok              String?

  storeSlug           String?  @unique
  storeDescription    String?
  logoUrl             String?
  bannerUrl           String?

  address1            String?
  address2            String?
  city                String?
  state               String?
  postalCode          String?
  country             String   @default("US")

  sellsNationwide     Boolean  @default(true)
  offersLocalPickup   Boolean  @default(false)
  offersLocalDelivery Boolean  @default(false)
  returnPolicy        String   @default("14_DAY_RETURNS")
  // Shopify mapping
  shopifyVendor       String   @unique

  // Temporary legacy reference while Nexus is removed
  nexusSellerId       String?  @unique

  // ACTIVE / SUSPENDED / INACTIVE / CLOSED
  status              String   @default("ACTIVE")

  // HairGrab Core is the financial authority
  commissionRate      Float    @default(7)

  activeProductLimit  Int      @default(50)

  // NOT_CONNECTED / PENDING / CONNECTED / RESTRICTED
  payoutStatus        String   @default("NOT_CONNECTED")

  stripeAccountId     String?  @unique

  // STANDARD / FAST / TRUSTED
  payoutTier                 String   @default("STANDARD")

  // Fast Payout qualification
  successfulDeliveredOrders Int      @default(0)
  fastPayoutEligibleAt      DateTime?
  fastPayoutUnlockedAt      DateTime?

  // If HairGrab needs to temporarily restrict fast payouts
  fastPayoutSuspendedAt      DateTime?
  fastPayoutSuspensionReason String?

  approvedAt          DateTime?
  suspendedAt         DateTime?
  deactivatedAt       DateTime?

  portalAccounts      SellerPortalAccount[]
  products            SellerProduct[]
  ledgerEntries       SellerLedgerEntry[]
  payoutBatches       PayoutBatch[]
  deliveredOrders     SellerDeliveredOrder[]

  onboarding          SellerOnboarding?

  approvedApplication SellerApplication? @relation("ApprovedSellerApplication")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([businessName])
  @@index([payoutTier])
}


// ==========================================================
// SELLER ONBOARDING
//
// One record per approved seller.
//
// Registration/application information is NOT entered again.
// The Seller record is prefilled from the approved application.
// This model tracks setup progress, autosave state, and the
// seller's place in the onboarding flow.
// ==========================================================

model SellerOnboarding {
  id                  String   @id @default(cuid())

  sellerId            String   @unique
  seller              Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // BUSINESS / STOREFRONT / FULFILLMENT / RETURNS /
  // PAYOUTS / AGREEMENTS / PRODUCTS / COMPLETE
  currentStep         String   @default("BUSINESS")

  // Overall onboarding state:
  // NOT_STARTED / IN_PROGRESS / COMPLETE
  status              String   @default("NOT_STARTED")

  // Individual step completion
  businessComplete    Boolean  @default(false)
  storefrontComplete  Boolean  @default(false)
  fulfillmentComplete Boolean  @default(false)
  returnsComplete     Boolean  @default(false)
  payoutsComplete     Boolean  @default(false)
  agreementsComplete  Boolean  @default(false)
  productsComplete    Boolean  @default(false)

  // Optional timestamps make the history auditable and let
  // HairGrab show exactly when each section was completed.
  businessCompletedAt    DateTime?
  storefrontCompletedAt  DateTime?
  fulfillmentCompletedAt DateTime?
  returnsCompletedAt     DateTime?
  payoutsCompletedAt     DateTime?
  agreementsCompletedAt  DateTime?
  productsCompletedAt    DateTime?

  startedAt           DateTime?
  lastSavedAt         DateTime?
  completedAt         DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([currentStep])
}


// ==========================================================
// SELLER PORTAL ACCOUNT
// ==========================================================

model SellerPortalAccount {
  id              String   @id @default(cuid())

  sellerId        String
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  email           String   @unique
  firstName       String?
  lastName        String?

  // OWNER / ADMIN / STAFF
  role            String   @default("OWNER")

  // INVITED / ACTIVE / DISABLED
  status          String   @default("INVITED")

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  invitedAt       DateTime @default(now())

  loginTokens     SellerLoginToken[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}


// ==========================================================
// PASSWORDLESS SELLER LOGIN
// ==========================================================

model SellerLoginToken {
  id              String   @id @default(cuid())

  portalAccountId String
  portalAccount   SellerPortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)

  tokenHash       String   @unique

  expiresAt       DateTime
  usedAt          DateTime?

  createdAt       DateTime @default(now())

  @@index([portalAccountId])
  @@index([expiresAt])
}


// ==========================================================
// SELLER PRODUCT OWNERSHIP
// ==========================================================

model SellerProduct {
  id                 String   @id @default(cuid())

  sellerId           String
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  shopifyProductId   String?  @unique
  shopifyHandle      String?

  title              String

  // DRAFT / PENDING_APPROVAL / ACTIVE / ARCHIVED / REJECTED
  status             String   @default("DRAFT")

  sellerSku          String?

  publishedToShopify Boolean  @default(false)
  publishedAt        DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}


// ==========================================================
// SELLER LEDGER
// ==========================================================

model SellerLedgerEntry {
  id                     String   @id @default(cuid())

  sellerId               String
  seller                 Seller   @relation(fields: [sellerId], references: [id])

  shopifyOrderId         String
  shopifyOrderName       String?
  shopifyLineItemId      String?

  idempotencyKey         String   @unique

  // SALE / REFUND / ADJUSTMENT / PAYOUT
  entryType              String   @default("SALE")

  // PENDING / ELIGIBLE / PAID / REVERSED
  status                 String   @default("PENDING")

  currency               String   @default("USD")

  // Snapshot of commission at transaction time
  commissionRate         Float

  grossAmountCents       Int      @default(0)
  commissionAmountCents  Int      @default(0)
  sellerEarningsCents    Int      @default(0)
  refundAmountCents      Int      @default(0)
  payoutAmountCents      Int      @default(0)

  description            String?

  // AWAITING_CLEARANCE / CLEARED / FAILED
  fundsStatus            String   @default("AWAITING_CLEARANCE")

  fundsClearedAt         DateTime?

  // Delivery information used for payout timing
  shopifyFulfillmentId   String?
  deliveredAt            DateTime?

  // When this SALE may become eligible for seller payout
  availableOn            DateTime?
  eligibilityCheckedAt   DateTime?

  paidAt                 DateTime?
  shopifyCreatedAt       DateTime?

  payoutBatchItem        PayoutBatchItem?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([status])
  @@index([entryType])
  @@index([fundsStatus])
  @@index([availableOn])
  @@index([deliveredAt])
  @@index([shopifyFulfillmentId])
}


// ==========================================================
// SUCCESSFULLY DELIVERED SELLER ORDERS
//
// One record per SELLER + SHOPIFY ORDER.
//
// This prevents multiple line items or repeated Shopify
// delivery events from inflating a seller's qualification
// count toward Fast Payouts.
// ==========================================================

model SellerDeliveredOrder {
  id                   String   @id @default(cuid())

  sellerId             String
  seller               Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  shopifyOrderId       String
  shopifyOrderName     String?

  shopifyFulfillmentId String?

  deliveredAt          DateTime

  // Set when this delivery has been counted toward
  // successfulDeliveredOrders.
  qualificationCountedAt DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([sellerId, shopifyOrderId])

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([deliveredAt])
  @@index([qualificationCountedAt])
}


// ==========================================================
// PAYOUT BATCH
// ==========================================================

model PayoutBatch {
  id                String   @id @default(cuid())

  batchCode         String   @unique

  sellerId          String
  seller            Seller   @relation(fields: [sellerId], references: [id])

  // DRAFT / READY / PROCESSING / PAID / FAILED / CANCELED
  status            String   @default("DRAFT")

  currency          String   @default("USD")

  totalAmountCents  Int      @default(0)

  externalPayoutId  String?
  failureReason     String?

  scheduledFor      DateTime?
  processedAt       DateTime?
  paidAt            DateTime?

  items             PayoutBatchItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}


// ==========================================================
// PAYOUT BATCH ITEM
// ==========================================================

model PayoutBatchItem {
  id            String   @id @default(cuid())

  payoutBatchId String
  payoutBatch   PayoutBatch @relation(fields: [payoutBatchId], references: [id])

  ledgerEntryId String   @unique
  ledgerEntry   SellerLedgerEntry @relation(fields: [ledgerEntryId], references: [id])

  amountCents   Int
  currency      String   @default("USD")

  createdAt     DateTime @default(now())

  @@index([payoutBatchId])
}