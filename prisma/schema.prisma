// HairGrab Core Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Seller {
  id              String   @id @default(cuid())
  sellerCode      String   @unique
  businessName    String
  shopifyVendor   String   @unique
  nexusSellerId   String?  @unique

  status          String   @default("ACTIVE")
  commissionRate  Float    @default(10)

  stripeAccountId String?  @unique
  payoutStatus    String   @default("NOT_CONNECTED")

  ledgerEntries   SellerLedgerEntry[]
  payoutBatches   PayoutBatch[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SellerLedgerEntry {
  id                     String   @id @default(cuid())

  sellerId               String
  seller                 Seller   @relation(fields: [sellerId], references: [id])

  shopifyOrderId          String
  shopifyOrderName        String?
  shopifyLineItemId       String?

  idempotencyKey          String   @unique

  // SALE
  // REFUND
  // ADJUSTMENT
  // PAYOUT
  entryType               String   @default("SALE")

  // PENDING
  // ELIGIBLE
  // PAID
  // REVERSED
  status                  String   @default("PENDING")

  currency                String   @default("USD")

  commissionRate          Float

  grossAmountCents        Int      @default(0)
  commissionAmountCents   Int      @default(0)
  sellerEarningsCents     Int      @default(0)
  refundAmountCents       Int      @default(0)
  payoutAmountCents       Int      @default(0)

  description             String?

  // SHOPIFY FUNDS CLEARANCE
  // AWAITING_CLEARANCE
  // CLEARED
  // FAILED
  fundsStatus             String   @default("AWAITING_CLEARANCE")

  fundsClearedAt          DateTime?
  availableOn             DateTime?
  eligibilityCheckedAt    DateTime?
  paidAt                  DateTime?
  shopifyCreatedAt        DateTime?

  payoutBatchItem         PayoutBatchItem?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([status])
  @@index([entryType])
  @@index([fundsStatus])
  @@index([availableOn])
}

model PayoutBatch {
  id               String   @id @default(cuid())

  // Human-readable HairGrab batch number
  batchCode         String   @unique

  sellerId          String
  seller            Seller   @relation(fields: [sellerId], references: [id])

  // DRAFT
  // READY
  // PROCESSING
  // PAID
  // FAILED
  // CANCELED
  status            String   @default("DRAFT")

  currency          String   @default("USD")

  totalAmountCents  Int      @default(0)

  // Future Nexus / Stripe payout references
  externalPayoutId  String?
  failureReason     String?

  scheduledFor      DateTime?
  processedAt       DateTime?
  paidAt            DateTime?

  items             PayoutBatchItem[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}

model PayoutBatchItem {
  id                String   @id @default(cuid())

  payoutBatchId     String
  payoutBatch       PayoutBatch @relation(fields: [payoutBatchId], references: [id])

  ledgerEntryId     String   @unique
  ledgerEntry       SellerLedgerEntry @relation(fields: [ledgerEntryId], references: [id])

  amountCents       Int
  currency          String   @default("USD")

  createdAt         DateTime @default(now())

  @@index([payoutBatchId])
}