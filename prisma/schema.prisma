// ==========================================================
// HAIRGRAB CORE
// HairGrab-owned marketplace operating system
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// SHOPIFY SESSION
// ==========================================================

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ==========================================================
// SELLER APPLICATION
// ==========================================================

model SellerApplication {
  id String @id @default(cuid())

  // PENDING / APPROVED / DECLINED / WITHDRAWN
  status String @default("PENDING")

  businessName     String
  contactFirstName String
  contactLastName  String
  email            String
  phone            String?

  website   String?
  instagram String?
  tiktok    String?

  address1   String?
  address2   String?
  city       String?
  state      String?
  postalCode String?
  country    String @default("US")

  yearsInBusiness   String?
  productCountRange String?
  canImportCsv      Boolean?

  sellsNationwide     Boolean @default(true)
  offersLocalPickup   Boolean @default(false)
  offersLocalDelivery Boolean @default(false)

  notes            String?
  adminReviewNotes String?

  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?
  declinedAt  DateTime?

  approvedSellerId String? @unique
  approvedSeller   Seller? @relation(
    "ApprovedSellerApplication",
    fields: [approvedSellerId],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([businessName])
}

// ==========================================================
// SELLER
// Permanent HairGrab marketplace identity.
// HG-0001 stays HG-0001 even if the business name changes.
// ==========================================================

model Seller {
  id String @id @default(cuid())

  sellerCode String @unique

  businessName      String
  legalBusinessName String?

  contactFirstName String?
  contactLastName  String?
  email            String?
  phone            String?

  website   String?
  instagram String?
  tiktok    String?

  storeSlug        String? @unique
  storeDescription String?
  logoUrl          String?
  bannerUrl        String?

  address1   String?
  address2   String?
  city       String?
  state      String?
  postalCode String?
  country    String @default("US")

  // Nationwide fulfillment
  sellsNationwide Boolean @default(true)

  // SELLER_MANAGED / HAIRGRAB_SHIPPING
  nationwideShippingMethod String @default("SELLER_MANAGED")

  // Additional fulfillment options
  offersLocalPickup   Boolean @default(false)
  offersLocalDelivery Boolean @default(false)

  returnPolicy String @default("14_DAY_RETURNS")

  // Shopify mapping
  shopifyVendor String @unique

  // Temporary legacy reference while Nexus is removed
  nexusSellerId String? @unique

  // ACTIVE / SUSPENDED / INACTIVE / CLOSED
  status String @default("ACTIVE")

  // HairGrab Core is the financial authority
  commissionRate Float @default(7)

  activeProductLimit Int @default(50)

  // NOT_CONNECTED / PENDING / CONNECTED / RESTRICTED
  payoutStatus String @default("NOT_CONNECTED")

  stripeAccountId String? @unique

  // STANDARD / FAST / TRUSTED
  payoutTier String @default("STANDARD")

  // Fast Payout qualification
  successfulDeliveredOrders Int       @default(0)
  fastPayoutEligibleAt      DateTime?
  fastPayoutUnlockedAt      DateTime?

  // If HairGrab needs to temporarily restrict fast payouts
  fastPayoutSuspendedAt      DateTime?
  fastPayoutSuspensionReason String?

  approvedAt    DateTime?
  suspendedAt   DateTime?
  deactivatedAt DateTime?

  portalAccounts    SellerPortalAccount[]
  products          SellerProduct[]
  ledgerEntries     SellerLedgerEntry[]
  payoutBatches     PayoutBatch[]
  deliveredOrders   SellerDeliveredOrder[]
  orderFulfillments SellerOrderFulfillment[]

  // HairGrab internal communications
  conversation      SellerConversation?
  announcementReads AnnouncementRead[]
  notifications     SellerNotification[]

  onboarding SellerOnboarding?

  approvedApplication SellerApplication?
    @relation("ApprovedSellerApplication")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([businessName])
  @@index([payoutTier])
}

// ==========================================================
// SELLER ONBOARDING
// ==========================================================

model SellerOnboarding {
  id String @id @default(cuid())

  sellerId String @unique
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  // BUSINESS / STOREFRONT / FULFILLMENT / RETURNS /
  // PAYOUTS / AGREEMENTS / PRODUCTS / COMPLETE
  currentStep String @default("BUSINESS")

  // NOT_STARTED / IN_PROGRESS / COMPLETE
  status String @default("NOT_STARTED")

  businessComplete    Boolean @default(false)
  storefrontComplete  Boolean @default(false)
  fulfillmentComplete Boolean @default(false)
  returnsComplete     Boolean @default(false)
  payoutsComplete     Boolean @default(false)
  agreementsComplete  Boolean @default(false)
  productsComplete    Boolean @default(false)

  businessCompletedAt    DateTime?
  storefrontCompletedAt  DateTime?
  fulfillmentCompletedAt DateTime?
  returnsCompletedAt     DateTime?
  payoutsCompletedAt     DateTime?
  agreementsCompletedAt  DateTime?
  productsCompletedAt    DateTime?

  startedAt   DateTime?
  lastSavedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentStep])
}

// ==========================================================
// SELLER PORTAL ACCOUNT
// ==========================================================

model SellerPortalAccount {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  email     String @unique
  firstName String?
  lastName  String?

  // OWNER / ADMIN / STAFF
  role String @default("OWNER")

  // INVITED / ACTIVE / DISABLED
  status String @default("INVITED")

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  invitedAt       DateTime @default(now())

  loginTokens SellerLoginToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}

// ==========================================================
// PASSWORDLESS SELLER LOGIN
// ==========================================================

model SellerLoginToken {
  id String @id @default(cuid())

  portalAccountId String
  portalAccount   SellerPortalAccount @relation(
    fields: [portalAccountId],
    references: [id],
    onDelete: Cascade
  )

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([portalAccountId])
  @@index([expiresAt])
}

// ==========================================================
// SELLER PRODUCT OWNERSHIP
// ==========================================================

model SellerProduct {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  shopifyProductId String? @unique
  shopifyHandle    String?

  title String

  // DRAFT / PENDING_APPROVAL / ACTIVE / ARCHIVED / REJECTED
  status String @default("DRAFT")

  sellerSku String?

  publishedToShopify Boolean @default(false)
  publishedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}

// ==========================================================
// SELLER LEDGER
// ==========================================================

model SellerLedgerEntry {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id]
  )

  shopifyOrderId    String
  shopifyOrderName  String?
  shopifyLineItemId String?

  idempotencyKey String @unique

  // SALE / REFUND / ADJUSTMENT / PAYOUT
  entryType String @default("SALE")

  // PENDING / ELIGIBLE / PAID / REVERSED
  status String @default("PENDING")

  currency String @default("USD")

  commissionRate Float

  grossAmountCents      Int @default(0)
  commissionAmountCents Int @default(0)
  sellerEarningsCents   Int @default(0)
  refundAmountCents     Int @default(0)
  payoutAmountCents     Int @default(0)

  description String?

  // AWAITING_CLEARANCE / CLEARED / FAILED
  fundsStatus String @default("AWAITING_CLEARANCE")

  fundsClearedAt DateTime?

  shopifyFulfillmentId String?
  deliveredAt          DateTime?

  availableOn          DateTime?
  eligibilityCheckedAt DateTime?

  paidAt           DateTime?
  shopifyCreatedAt DateTime?

  payoutBatchItem PayoutBatchItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([status])
  @@index([entryType])
  @@index([fundsStatus])
  @@index([availableOn])
  @@index([deliveredAt])
  @@index([shopifyFulfillmentId])
}

// ==========================================================
// SUCCESSFULLY DELIVERED SELLER ORDERS
// ==========================================================

model SellerDeliveredOrder {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  shopifyOrderId   String
  shopifyOrderName String?

  shopifyFulfillmentId String?

  deliveredAt DateTime

  qualificationCountedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, shopifyOrderId])
  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([deliveredAt])
  @@index([qualificationCountedAt])
}

// ==========================================================
// PAYOUT BATCH
// ==========================================================

model PayoutBatch {
  id String @id @default(cuid())

  batchCode String @unique

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id]
  )

  // DRAFT / READY / PROCESSING / PAID / FAILED / CANCELED
  status String @default("DRAFT")

  currency String @default("USD")

  totalAmountCents Int @default(0)

  externalPayoutId String?
  failureReason    String?

  scheduledFor DateTime?
  processedAt  DateTime?
  paidAt       DateTime?

  items PayoutBatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}

// ==========================================================
// PAYOUT BATCH ITEM
// ==========================================================

model PayoutBatchItem {
  id String @id @default(cuid())

  payoutBatchId String
  payoutBatch   PayoutBatch @relation(
    fields: [payoutBatchId],
    references: [id]
  )

  ledgerEntryId String @unique
  ledgerEntry   SellerLedgerEntry @relation(
    fields: [ledgerEntryId],
    references: [id]
  )

  amountCents Int
  currency    String @default("USD")

  createdAt DateTime @default(now())

  @@index([payoutBatchId])
}

// ==========================================================
// HAIRGRAB MARKETPLACE SETTINGS
// ==========================================================

model MarketplaceSettings {
  id String @id @default("hairgrab")

  // Seller defaults
  standardCommissionRate       Float @default(7)
  foundingSellerCommissionRate Float @default(5)
  defaultActiveProductLimit    Int   @default(50)

  // Marketplace access
  sellerApplicationsOpen Boolean @default(true)
  requireSellerApproval  Boolean @default(true)

  // Product controls
  requireProductApproval  Boolean @default(true)
  productPublishingPaused Boolean @default(false)

  // Fulfillment defaults
  defaultShippingSlaHours Int    @default(48)
  defaultReturnPolicy     String @default("14_DAY_RETURNS")

  // Feature availability
  localPickupEnabled   Boolean @default(true)
  localDeliveryEnabled Boolean @default(true)

  // Support
  supportEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================================
// SELLER ORDER FULFILLMENT
// ==========================================================

model SellerOrderFulfillment {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  shopifyOrderId   String
  shopifyOrderName String?

  // SELLER_MANAGED / HAIRGRAB_SHIPPING /
  // LOCAL_PICKUP / HAIRGRAB_SAME_DAY
  fulfillmentMethod String

  // READY / LABEL_READY / READY_FOR_PICKUP /
  // COURIER_REQUESTED / SHIPPED / DELIVERED / CANCELED
  status String @default("READY")

  // Parcel shipping
  carrier        String?
  trackingNumber String?
  trackingUrl    String?

  // HairGrab Shipping
  shippingLabelUrl         String?
  shippingRateId           String?
  shippingCostCents        Int?
  shippingPurchaseId       String?
  shippingPurchaseStatus   String?
  shippingPurchaseError    String?
  packageType              String?
  packageLengthInches      Float?
  packageWidthInches       Float?
  packageHeightInches      Float?
  packageWeightOunces      Float?
  shippingLabelPurchasedAt DateTime?

  // Same-day courier
  courierProvider   String?
  courierDeliveryId String?
  courierStatus     String?
  courierFeeCents   Int?

  readyForPickupAt DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  canceledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, shopifyOrderId])
  @@index([sellerId])
  @@index([shopifyOrderId])
  @@index([fulfillmentMethod])
  @@index([status])
}

// ==========================================================
// SELLER CONVERSATION
//
// One private HairGrab <-> seller conversation per seller.
// ==========================================================

model SellerConversation {
  id String @id @default(cuid())

  sellerId String @unique
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  // OPEN / CLOSED
  status String @default("OPEN")

  subject String @default("HairGrab Support")

  lastMessageAt DateTime?

  messages SellerMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastMessageAt])
}

// ==========================================================
// SELLER MESSAGE
//
// Internal private communication between HairGrab and seller.
// ==========================================================

model SellerMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   SellerConversation @relation(
    fields: [conversationId],
    references: [id],
    onDelete: Cascade
  )

  // HAIRGRAB / SELLER
  senderType String

  senderName String?

  body String

  // Read tracking for both sides
  readBySellerAt   DateTime?
  readByHairGrabAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderType])
  @@index([createdAt])
  @@index([readBySellerAt])
  @@index([readByHairGrabAt])
}

// ==========================================================
// HAIRGRAB ANNOUNCEMENT
//
// Marketplace announcements created by HairGrab.
//
// audience:
// ALL      = every seller
// ACTIVE   = active sellers
// SELECTED = selected sellers are represented in AnnouncementRead
// ==========================================================

model Announcement {
  id String @id @default(cuid())

  title String
  body  String

  // DRAFT / PUBLISHED / ARCHIVED
  status String @default("DRAFT")

  // NORMAL / IMPORTANT / URGENT
  priority String @default("NORMAL")

  // ALL / ACTIVE / SELECTED
  audience String @default("ALL")

  createdByName String?

  publishedAt DateTime?
  expiresAt   DateTime?

  reads AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([audience])
  @@index([publishedAt])
  @@index([expiresAt])
}

// ==========================================================
// ANNOUNCEMENT SELLER STATUS
//
// For ALL/ACTIVE announcements this records when a seller
// opens the announcement.
//
// For SELECTED announcements these rows also identify the
// sellers who should receive the announcement.
// ==========================================================

model AnnouncementRead {
  id String @id @default(cuid())

  announcementId String
  announcement   Announcement @relation(
    fields: [announcementId],
    references: [id],
    onDelete: Cascade
  )

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  deliveredAt DateTime @default(now())
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([announcementId, sellerId])
  @@index([announcementId])
  @@index([sellerId])
  @@index([readAt])
}

// ==========================================================
// SELLER NOTIFICATION
//
// System-generated alerts shown in the seller portal.
// Examples:
// NEW_ORDER
// PRODUCT_APPROVED
// PRODUCT_REJECTED
// PAYOUT_READY
// PAYOUT_SENT
// NEW_MESSAGE
// ANNOUNCEMENT
// SHIPPING
// ACCOUNT
// ==========================================================

model SellerNotification {
  id String @id @default(cuid())

  sellerId String
  seller   Seller @relation(
    fields: [sellerId],
    references: [id],
    onDelete: Cascade
  )

  type String

  title   String
  message String

  // Optional seller portal destination
  linkUrl String?

  // Optional unique key prevents duplicate webhook notifications.
  dedupeKey String? @unique

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}